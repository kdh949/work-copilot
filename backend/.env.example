PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=work_copilot
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
FRONTEND_ORIGINS=http://localhost:5173
# 프로덕션에서는 WAF와 Nginx를 포함한 신뢰 프록시 홉 수를 명시해야 합니다.
# 로컬에서 API에 직접 접속할 때는 0을 유지합니다.
TRUST_PROXY_HOPS=0

# Do not add values to source control. These names are provisioned in the deployment environment.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
KEYCLOAK_ALLOWED_EMAIL_DOMAINS=
OIDC_ATTEMPT_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=3600
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_VERSION=1
# Set both values only during a planned key rotation. Keep the previous key
# available until every active record has been re-encrypted with the current key.
INTEGRATION_ENCRYPTION_PREVIOUS_KEY=
INTEGRATION_ENCRYPTION_PREVIOUS_KEY_VERSION=
INTEGRATION_CALLBACK_BASE_URL=
# Jira·Confluence의 hostname만 쉼표로 구분합니다. https://, 경로, 포트는 넣지 않습니다.
# 예: jira.example.com,confluence.example.com
INTEGRATION_BASE_URL_HOST_ALLOWLIST=
# 프로필에 입력할 수 있는 OAuth scope를 쉼표로 구분합니다.
INTEGRATION_JIRA_SCOPE_ALLOWLIST=READ
INTEGRATION_CONFLUENCE_SCOPE_ALLOWLIST=READ
TRANSIENT_CONTENT_ENCRYPTION_KEY=
TRANSIENT_CONTENT_ENCRYPTION_KEY_VERSION=1
# Set both values only during a planned key rotation. Keep the previous key
# available until every active record has been re-encrypted with the current key.
TRANSIENT_CONTENT_ENCRYPTION_PREVIOUS_KEY=
TRANSIENT_CONTENT_ENCRYPTION_PREVIOUS_KEY_VERSION=
TRANSIENT_EVIDENCE_TTL_SECONDS=86400
TRANSIENT_EVIDENCE_PURGE_INTERVAL_SECONDS=900

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
