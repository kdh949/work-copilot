### Keycloak 로그인 시작
# 브라우저에서 이 요청을 열어 Keycloak 로그인을 마칩니다.
GET http://localhost:3000/auth/oidc/login

### 현재 BFF 세션 확인
# HTTP client의 cookie jar가 work_copilot_session을 보존해야 합니다.
GET http://localhost:3000/auth/me

### 변경 요청용 CSRF 값 발급 및 세션 회전
# 응답의 csrfToken은 메모리 변수로만 보관합니다.
# @name csrf
GET http://localhost:3000/auth/csrf

> {%
    client.global.set("csrfToken", response.body.csrfToken);
%}

### 회사 위키 생성 - Keycloak work-copilot-admin claim 필요
POST http://localhost:3000/posts
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "title": "인사팀 온보딩 안내",
  "content": "입사 첫날에는 근로계약서, 보안 서약서, 급여 계좌 등록을 먼저 완료합니다.",
  "department": "인사",
  "tags": ["온보딩", "급여", "인사"]
}

### 로그아웃
POST http://localhost:3000/auth/logout
X-CSRF-Token: {{csrfToken}}
