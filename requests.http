### 회원가입
POST http://localhost:3000/auth/signup
Content-Type: application/json

{
  "email": "newbie@example.com",
  "password": "12345678",
  "nickname": "신입사원"
}

### 로그인
# @name login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "newbie@example.com",
  "password": "12345678"
}

> {%
    client.global.set("accessToken", response.body.accessToken);
%}

### 내 정보
GET http://localhost:3000/auth/me
Authorization: Bearer {{accessToken}}

### 게시글 생성
POST http://localhost:3000/posts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "인사팀 온보딩 안내",
  "content": "입사 첫날에는 근로계약서, 보안 서약서, 급여 계좌 등록을 먼저 완료합니다.",
  "department": "인사",
  "tags": ["온보딩", "급여", "인사"]
}

### 게시글 목록, 페이징, 검색
GET http://localhost:3000/posts?page=1&limit=5&keyword=급여&department=인사&tag=온보딩

### 게시글 상세
GET http://localhost:3000/posts/1

### 게시글 수정
PATCH http://localhost:3000/posts/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "인사팀 온보딩 안내 수정",
  "tags": ["온보딩", "급여", "계약"]
}

### 댓글 작성
POST http://localhost:3000/posts/1/comments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "급여 계좌 등록 위치도 추가하면 좋겠습니다."
}

### 댓글 수정
PATCH http://localhost:3000/posts/1/comments/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "급여 계좌 등록 메뉴 위치도 추가하면 좋겠습니다."
}

### 댓글 삭제
DELETE http://localhost:3000/posts/1/comments/1
Authorization: Bearer {{accessToken}}

### 내 질문 노트 생성 - AI가 댓글로 답변
POST http://localhost:3000/posts/questions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "입사 첫날 급여 계좌는 어디서 등록하나요?",
  "content": "인사팀 온보딩 문서를 봤는데 급여 계좌 등록 메뉴 위치가 헷갈립니다.",
  "department": "인사",
  "tags": ["급여", "온보딩", "질문"]
}

### 내 질문 노트 목록
GET http://localhost:3000/posts/questions/my?page=1&limit=5&keyword=급여
Authorization: Bearer {{accessToken}}

### RAG 챗봇
POST http://localhost:3000/ai/chat
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "question": "입사 첫날 무엇부터 해야 하나요?",
  "department": "인사"
}

### 온보딩 추천
POST http://localhost:3000/ai/onboarding
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "department": "인사",
  "employeeName": "신입사원"
}

### 강의안 생성
POST http://localhost:3000/ai/lecture
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "department": "인사",
  "employeeName": "신입사원"
}

### Agent 실행
POST http://localhost:3000/ai/agent
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "question": "온보딩 중 휴일과 급여 관련해서 확인할 내용을 알려줘",
  "department": "인사"
}

### FastAPI MCP tools/list
POST http://localhost:8000/mcp
Content-Type: application/json
X-API-Key: local-mcp-key

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/list",
  "params": {}
}

### FastAPI MCP tools/call
POST http://localhost:8000/mcp
Content-Type: application/json
X-API-Key: local-mcp-key

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/call",
  "params": {
    "name": "get_company_holiday",
    "arguments": {
      "country": "KR",
      "year": 2026
    }
  }
}
