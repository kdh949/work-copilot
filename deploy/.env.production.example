# Docker publishes the application only on this Ubuntu private/LAN address.
SERVER_BIND_ADDRESS=192.168.0.10

DB_USERNAME=work_copilot
DB_PASSWORD=replace-with-a-long-random-password
DB_DATABASE=work_copilot
# URL-encode the password when it contains URL-reserved characters.
DATABASE_URL=postgresql://work_copilot:replace-with-url-encoded-password@postgres:5432/work_copilot

FRONTEND_ORIGINS=https://work-copilot.dhkim.cloud
TRUST_PROXY_HOPS=2

KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://work-copilot.dhkim.cloud/api/auth/oidc/callback
KEYCLOAK_ALLOWED_EMAIL_DOMAINS=
OIDC_ATTEMPT_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=3600

INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_VERSION=1
INTEGRATION_ENCRYPTION_PREVIOUS_KEY=
INTEGRATION_ENCRYPTION_PREVIOUS_KEY_VERSION=
INTEGRATION_CALLBACK_BASE_URL=https://work-copilot.dhkim.cloud/api
INTEGRATION_BASE_URL_HOST_ALLOWLIST=jira.dhkim.cloud,wiki.dhkim.cloud
INTEGRATION_JIRA_SCOPE_ALLOWLIST=READ
INTEGRATION_CONFLUENCE_SCOPE_ALLOWLIST=READ
# 기본은 외부 쓰기를 하지 않는 mock입니다. 검증된 OAuth2 contract 후에만 real로 변경합니다.
PUBLICATION_WRITE_MODE=mock

TRANSIENT_CONTENT_ENCRYPTION_KEY=
TRANSIENT_CONTENT_ENCRYPTION_KEY_VERSION=1
TRANSIENT_CONTENT_ENCRYPTION_PREVIOUS_KEY=
TRANSIENT_CONTENT_ENCRYPTION_PREVIOUS_KEY_VERSION=
TRANSIENT_EVIDENCE_TTL_SECONDS=86400
TRANSIENT_EVIDENCE_PURGE_INTERVAL_SECONDS=900
WORK_COPILOT_CLEANUP_MAX_AGE_SECONDS=4200
CLEANUP_INTERVAL_SECONDS=900

WEBHOOK_SHADOW_MODE=false
WEBHOOK_INGRESS_VERIFIED=false
WEBHOOK_INGRESS_ALLOWED_CIDRS=

AI_SERVICE_API_KEY=replace-with-a-shared-random-service-key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
WORK_BRIEF_OPENAI_MODEL=gpt-5.6
WORK_BRIEF_DLP_RULES_JSON=[]
RAG_RETRIEVAL_MODE=hybrid-chunks
RAG_MIN_CONFIDENCE=0
OPENAI_INPUT_COST_PER_1M=0.15
OPENAI_OUTPUT_COST_PER_1M=0.60
MCP_API_KEY=replace-with-a-random-mcp-key
HOLIDAY_COUNTRY=KR
HOLIDAY_API_URL=https://date.nager.at/api/v3/PublicHolidays
